{
  // One free-plan Worker: static UI assets, CRM lead records (D1), snapshot pointer and agent relay (Workers AI).
  // Property and permit data are read by the browser from IPFS; nothing here ingests data.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travis-roofing-crm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roofing-crm",
      "database_id": "02c72cd6-ca61-4c63-9666-c1f75719b1ea",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "SNAPSHOT_HISTORY_URL": "https://raw.githubusercontent.com/richardreid1811/oracle-property-intelligence-platform-pipeline-travis-tx/travis-pipeline/runs/history.json",
  },
  "observability": { "enabled": true },
}
